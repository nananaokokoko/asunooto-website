# Notion API設定
# NotionのAPIキーを取得: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# NotionデータベースのID
# データベースのURLから取得できます
# 例: https://www.notion.so/xxxxx?v=yyyy の xxxxx部分
NOTION_MEMBERS_DATABASE_ID=your_members_database_id_here
NOTION_NEWS_DATABASE_ID=your_news_database_id_here
NOTION_HISTORY_DATABASE_ID=your_history_database_id_here
NOTION_HISTORY_DATABASE_ID=your_history_database_id_here
